# Server porti (Render bu qiymatni o'zi beradi, lokalda 5000 ishlatiladi)
PORT=5000

# MongoDB ulanish manzili (MongoDB Atlas'dan oling)
# Namuna: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/expense-tracker
MONGO_URI=mongodb://127.0.0.1:27017/expense-tracker

# Frontend (Vercel) manzilingiz — CORS uchun kerak.
# Bir nechta domen bo'lsa, vergul bilan ajrating.
FRONTEND_URL=https://SIZNING-VERCEL-MANZILINGIZ.vercel.app

# JWT token imzolash uchun maxfiy kalit — uzun va tasodifiy bo'lsin.
# Terminalda generatsiya qilish: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=SIZNING_MAXFIY_KALITINGIZ_BUNI_ALMASHTIRING
